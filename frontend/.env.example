# ==============================================================================
# Frontend Environment Configuration Template (.env.example)
# Copy this file to .env.local or .env in the frontend/ folder.
# NOTE: Only variables prefixed with VITE_ are exposed to the client bundle.
# NEVER store secret backend keys here!
# ==============================================================================

# Backend API Base URL
VITE_API_BASE_URL="http://localhost:8000"

# Supabase Client Public Configuration
# Safe to expose publicly in client app; security enforced via PostgreSQL RLS policies
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-public-key"
