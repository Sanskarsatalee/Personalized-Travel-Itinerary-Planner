# ==============================================================================
# Backend Environment Configuration Template (.env.example)
# Copy this file to .env and supply your local or production credentials.
# NEVER commit your actual .env file to Git!
# ==============================================================================

# Server Environment
APP_NAME="Personalized Travel Itinerary Planner"
APP_ENV="development"
PORT=8000
DEBUG=True
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Supabase Credentials (PostgreSQL & Auth)
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# Generative AI API Configuration
# Get your Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"
