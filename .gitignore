# ==============================================================================
# Personalized Travel Itinerary Planner - .gitignore
# ==============================================================================

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Node.js & Frontend Build Outputs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
frontend/dist/
frontend/dist-ssr/
frontend/build/
.cache/

# Environment Variables & Sensitive Credentials (NEVER COMMIT)
.env
.env.*
*.env
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.production

# Preserve documentation example env files
!.env.example
!backend/.env.example
!frontend/.env.example

# IDE & Code Editor Configurations
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Logs and databases
*.log
*.sqlite3
